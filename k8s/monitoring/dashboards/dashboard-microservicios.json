{
  "dashboard": {
    "id": null,
    "title": "Microservicios Order System",
    "timezone": "browser",
    "panels": [
      {
        "type": "graph",
        "title": "Product Catalog Requests Total",
        "datasource": "Prometheus",
        "targets": [{"expr": "product_catalog_requests_total"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "type": "graph",
        "title": "Product Catalog Request Latency (95th percentile)",
        "datasource": "Prometheus",
        "targets": [{"expr": "histogram_quantile(0.95, sum(rate(product_catalog_requests_duration_seconds_bucket[5m])) by (le))"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "type": "graph",
        "title": "Order Management Requests Total",
        "datasource": "Prometheus",
        "targets": [{"expr": "order_management_requests_total"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "type": "graph",
        "title": "Order Management Request Latency",
        "datasource": "Prometheus",
        "targets": [{"expr": "histogram_quantile(0.95, sum(rate(order_management_requests_duration_seconds_bucket[5m])) by (le))"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "type": "stat",
        "title": "Pending Orders",
        "datasource": "Prometheus",
        "targets": [{"expr": "order_management_orders_pending"}],
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 16}
      },
      {
        "type": "graph",
        "title": "CPU Usage (ordersystem namespace)",
        "datasource": "Prometheus",
        "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"ordersystem\"}[2m])) by (pod)"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ]
  },
  "overwrite": true
}
